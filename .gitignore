# Local .terraform directory (contains large binaries)
**/.terraform/*

# State files (contains your secrets in plain text)
*.tfstate
*.tfstate.*

# Variables files (if they contain real secrets)
*.tfvars
*.tfvars.json

# Crash logs
crash.log

# OS generated files
.DS_Store

infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup

# Node modules
node_modules/

# Lambda build artifacts (build with build.sh before deploying)
lambdas/**/*.zip
layers/**/*.zip
layers/nodejs/
dist/

# Environment files with actual secrets (DO NOT COMMIT)
.env.local
.env.*.local

# Frontend build artifacts (generated during build)
frontend/.next/
frontend/out/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/